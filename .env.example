# LLM API 配置（复制本文件为 .env 并填入您的 Key）
# 推荐平台（任选其一，均为 OpenAI 兼容协议）：
#   DeepSeek:  https://platform.deepseek.com        base_url: https://api.deepseek.com
#   阿里通义:  https://bailian.console.aliyun.com   base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Moonshot:  https://platform.moonshot.cn         base_url: https://api.moonshot.cn/v1
#   OpenAI:    https://platform.openai.com          base_url: https://api.openai.com/v1

LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
