<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>结直肠癌研究周报 · 往期归档</title>
<style>
:root{--blue:#0279EE;--navy:#0f172a;--border:#e2e8f0;--muted:#64748b;--cream:#FAF9F3}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:"Liberation Sans","Arimo","PingFang SC","Microsoft YaHei",sans-serif;background:var(--cream);color:var(--navy);line-height:1.6}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
header{background:#fff;border-bottom:1px solid var(--border)}
header .wrap{display:flex;align-items:center;gap:10px;padding:16px 20px}
.logo{display:flex;align-items:center;gap:8px}
.logo .ic{width:30px;height:30px;border-radius:8px;background:var(--blue);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:15px;font-weight:700}
.logo b{font-size:17px}
header .sub{margin-left:auto;color:var(--muted);font-size:13px}
.hero{background:#fff;border:2px solid var(--blue);border-radius:16px;padding:34px 38px;margin:34px 0 44px}
.hero .tag{color:var(--blue);font-weight:700;font-size:14px;letter-spacing:.5px}
.hero h2{font-size:30px;margin:10px 0 18px}
.hero .nums{display:flex;gap:56px;margin-bottom:26px}
.hero .num{font-size:44px;font-weight:800;color:var(--blue);line-height:1.1}
.hero .numlbl{color:#475569;font-size:14px;margin-top:4px}
.hero a.btn{display:inline-block;background:var(--blue);color:#fff;text-decoration:none;font-weight:700;font-size:16px;padding:13px 28px;border-radius:12px}
.hero a.btn:hover{filter:brightness(1.08)}
h2.arch{font-size:24px;margin:8px 0 14px}
table{width:100%;border-collapse:collapse;background:#fff;font-size:15px}
th{background:#e9e5dc;text-align:left;padding:13px 16px;font-size:14px}
td{padding:14px 16px;border-top:1px solid #eee}
tr.latest td{font-weight:700}
.badge-new{display:inline-block;background:var(--blue);color:#fff;font-size:12px;font-weight:700;border-radius:6px;padding:2px 8px;margin-right:8px;vertical-align:1px}
a{color:var(--blue);text-decoration:none;font-weight:600}
a:hover{text-decoration:underline}
.sep{color:#94a3b8;font-weight:400;margin:0 6px}
.foot{color:var(--muted);font-size:13px;text-align:center;margin:36px 0 28px}
@media(max-width:640px){.hero .nums{gap:28px}.hero .num{font-size:34px}.hero h2{font-size:22px}}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <span class="logo"><span class="ic">周</span><b>结直肠癌研究周报</b></span>
    <span class="sub">肠癌全域 · 肝转移为重点亚方向 · 每周更新</span>
  </div>
</header>

<div class="wrap">
  {% if latest %}
  <div class="hero">
    <div class="tag">最新一期</div>
    <h2>{{ latest.window_start }} 至 {{ latest.window_end }}</h2>
    <div class="nums">
      <div><div class="num">{{ latest.n_papers }}</div><div class="numlbl">纳入文献（篇）</div></div>
      <div><div class="num">{{ latest.n_trials }}</div><div class="numlbl">临床试验动态（项）</div></div>
    </div>
    <a class="btn" href="issues/{{ latest.id }}/index.html">阅读本期周报 →</a>
  </div>
  {% endif %}

  <h2 class="arch">往期归档（{{ issues | length }} 期）</h2>
  <table>
    <thead><tr><th></th><th>检索窗口</th><th>文献（篇）</th><th>试验（项）</th><th>链接</th></tr></thead>
    <tbody>
      {% for i in issues %}
      <tr {% if loop.first %}class="latest"{% endif %}>
        <td>{% if loop.first %}<span class="badge-new">最新</span>{% endif %}</td>
        <td>{{ i.window_start }} 至 {{ i.window_end }}</td>
        <td>{{ i.n_papers }}</td>
        <td>{{ i.n_trials }}</td>
        <td><a href="issues/{{ i.id }}/index.html">阅读本期</a><span class="sep">·</span><a href="issues/{{ i.id }}/report.md">Markdown</a></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="foot">
    生成时间 {{ generated }} · 每周一 09:00 自动更新 ·
    <a href="all/index.html">全部文献库（累计视图）</a>
  </div>
</div>
</body>
</html>
